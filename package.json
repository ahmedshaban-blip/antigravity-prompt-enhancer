{
  "name": "antigravity-prompt-enhancer",
  "displayName": "Antigravity Prompt Enhancer",
  "description": "Intelligent Two-Stage Context Discovery and Master Prompt Synthesis for Antigravity AI Chat",
  "version": "1.0.3",
  "publisher": "ahmedshaban",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ahmedshaban-blip/antigravity-prompt-enhancer.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "prompt enhancer",
    "antigravity",
    "context discovery",
    "vscode.lm",
    "ai assistant"
  ],
  "license": "MIT",
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "antigravity-enhancer-sidebar",
          "title": "Prompt Enhancer",
          "icon": "assets/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "antigravity-enhancer-sidebar": [
        {
          "type": "webview",
          "id": "antigravityEnhancer.settingsView",
          "name": "Configuration & Controls",
          "icon": "assets/sidebar-icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "antigravityEnhancer.enhancePrompt",
        "title": "Enhance Chat Prompt",
        "category": "Antigravity"
      },
      {
        "command": "antigravityEnhancer.openSettingsView",
        "title": "Open Prompt Enhancer Settings",
        "category": "Antigravity",
        "icon": "$(gear)"
      }
    ],
    "keybindings": [
      {
        "command": "antigravityEnhancer.enhancePrompt",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e"
      }
    ],
    "configuration": {
      "title": "Antigravity Prompt Enhancer",
      "properties": {
        "antigravityEnhancer.provider": {
          "type": "string",
          "enum": [
            "openrouter",
            "gemini",
            "openai_compatible"
          ],
          "default": "openrouter",
          "description": "AI provider backend: OpenRouter, Google Gemini API, or OpenAI-compatible REST API."
        },
        "antigravityEnhancer.openrouterApiKey": {
          "type": "string",
          "default": "",
          "description": "OpenRouter API key (supports Claude 3.5 Sonnet, DeepSeek V3/R1, Llama 3.3, etc.)."
        },
        "antigravityEnhancer.openrouterModel": {
          "type": "string",
          "default": "anthropic/claude-3.5-sonnet",
          "description": "OpenRouter model identifier (e.g. anthropic/claude-3.5-sonnet, deepseek/deepseek-chat, google/gemini-2.0-flash-exp:free)."
        },
        "antigravityEnhancer.geminiApiKey": {
          "type": "string",
          "default": "",
          "description": "Google Gemini API key (free at aistudio.google.com). Powers Gemini 2.5 Flash / 1.5 Pro directly."
        },
        "antigravityEnhancer.geminiModel": {
          "type": "string",
          "default": "gemini-2.5-flash",
          "description": "Google Gemini model identifier (e.g. gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro)."
        },
        "antigravityEnhancer.openaiBaseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "Base URL for OpenAI-compatible endpoint."
        },
        "antigravityEnhancer.openaiApiKey": {
          "type": "string",
          "default": "",
          "description": "API key for OpenAI-compatible endpoint."
        },
        "antigravityEnhancer.openaiModel": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "Model identifier for OpenAI-compatible endpoint."
        },
        "antigravityEnhancer.maxContextFiles": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "description": "Maximum number of workspace files to include in Stage 1 context."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.5.2"
  }
}
